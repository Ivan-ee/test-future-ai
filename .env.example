# Конфигурация test-future. Скопируйте в .env и при необходимости измените.
#   cp .env.example .env
# Все переменные имеют значения по умолчанию — `make dev` работает без правки.

# ─── ИИ (опционально) ───────────────────────────────────────────────────────
# Сентимент новостей — единственное применение ИИ в системе (T4). Без ключа
# сентимент выключен — прогноз считается по 3 техническим факторам
# (RSI, моментум, объём).
#
# Поддерживается любой OpenAI-совместимый провайдер. Три переменные:
#   OPENAI_API_KEY  — ключ провайдера
#   OPENAI_BASE_URL — эндпоинт (по умолчанию api.openai.com)
#   OPENAI_MODEL    — модель (по умолчанию gpt-4o-mini)
#
# Варианты:
#   • OpenAI:    https://platform.openai.com/api-keys
#       OPENAI_API_KEY=sk-...
#       (BaseURL/Model можно не задавать — подставятся по умолчанию)
#
#   • Kimi / Moonshot (OpenAI-совместимый):
#       OPENAI_API_KEY=sk-...                  (https://platform.moonshot.cn)
#       OPENAI_BASE_URL=https://api.moonshot.cn/v1
#       OPENAI_MODEL=moonshot-v1-8k
#
#   • DeepSeek, OpenRouter, локальный Ollama — аналогично, своим BaseURL/Model.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ─── Источники данных ────────────────────────────────────────────────────────
# Базовый URL CoinGecko API — цены, рыночные графики, капитализация.
# Free public tier, ключ не требуется.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Базовый URL CoinPaprika API — новости по криптовалютам.
# ВНИМАНИЕ: публичный endpoint новостей (/v1/news) убран CoinPaprika — теперь
# отдаёт 404. Пустое значение ВЫКЛЮЧАЕТ этот источник (новости идут только из
# RSS). Если CoinPaprika вернёт endpoint — впишите URL, чтобы включить обратно.
# COINPAPRIKA_BASE_URL=https://api.coinpaprika.com/v1
COINPAPRIKA_BASE_URL=

# RSS-ленты (CoinDesk, Cointelegraph) захардкожены в internal/source/rss —
# URL лент не вынесены в конфиг.

# ─── Сеть ────────────────────────────────────────────────────────────────────
# Порт Go-бэкенда (HTTP API).
BACKEND_PORT=8081

# Порт Next.js фронтенда.
FRONTEND_PORT=3001

# ─── Хранилище ───────────────────────────────────────────────────────────────
# Путь к файлу SQLite. Родительский каталог создаётся автоматически.
DB_PATH=data/testfuture.db

# ─── Worker-цикл ─────────────────────────────────────────────────────────────
# Период опроса источников (цен и новостей), минут. Прогнозы пересчитываются
# и resolve-цикл работает по фиксированному расписанию (раз в час) — см.
# docs/architecture.md.
FETCH_INTERVAL_MIN=10
