# Пример конфигурации. Скопируйте в .env и при необходимости измените.

# OpenAI API ключ для оценки сентимента новостей (T4). Без ключа прогноз
# работает на 3 факторах — сентимент новостей не используется.
OPENAI_API_KEY=

# Базовый URL CoinGecko API (цены).
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Базовый URL CoinPaprika API (новости).
COINPAPRIKA_BASE_URL=https://api.coinpaprika.com/v1

# Порт Go-бэкенда.
BACKEND_PORT=8081

# Порт Next.js фронтенда.
FRONTEND_PORT=3001

# Путь к файлу SQLite.
DB_PATH=data/testfuture.db

# Период опроса источников данных, минут (по умолчанию 10).
FETCH_INTERVAL_MIN=10
