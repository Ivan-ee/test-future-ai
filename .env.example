# Пример конфигурации. Скопируйте в .env и при необходимости измените.

# OpenAI API ключ (используется в T4/T5 для сентимента новостей; в T1 не нужен).
OPENAI_API_KEY=

# Базовый URL CoinGecko API.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Порт Go-бэкенда.
BACKEND_PORT=8081

# Порт Next.js фронтенда.
FRONTEND_PORT=3001

# Путь к файлу SQLite.
DB_PATH=data/testfuture.db

# Период опроса источников данных, минут (по умолчанию 10).
FETCH_INTERVAL_MIN=10
